# --- Local MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db
PORT=3000

# --- Hosted MySQL (use instead of DB_HOST/PORT/USER/PASSWORD) ---
# MYSQL_URL=mysql://user:password@host:3306/anything
# DB_SSL=true          # required by most hosted MySQL services outside a private network
# DB_SSL_CA=ca.pem     # CA certificate file, if your provider gives one

# Create tables + sample data automatically when the database is empty (default true)
AUTO_INIT_DB=true

# Keep logins valid across server restarts (any long random string). Set this in production.
AUTH_SECRET=
# Show demo account credentials on the login page
SHOW_DEMO_ACCOUNTS=true
